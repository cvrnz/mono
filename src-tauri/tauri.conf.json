{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mono",
  "version": "0.1.0",
  "identifier": "dev.mono.app",
  "build": {
    "beforeDevCommand": "bun run agent && bun run dev",
    "devUrl": "http://127.0.0.1:9245",
    "beforeBuildCommand": "bun run agent && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mono",
        "width": 1400,
        "height": 900,
        "minWidth": 600,
        "minHeight": 400,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1e1e1e",
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": { "resources/agent/mono-agent-*": "agent/" }
  }
}
